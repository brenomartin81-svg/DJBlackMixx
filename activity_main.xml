<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:padding="16dp">

    <!-- ================= DECK A (Esquerda) ================= -->
    <LinearLayout
        android:id="@+id/deckA_layout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#1E1E1E"
        android:padding="12dp"
        app:layout_constraintWidth_percent="0.38"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DECK A"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvTrackA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nenhuma música carregada"
            android:textColor="#FF9800"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnLoadA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carregar Música"
            android:layout_marginBottom="6dp"/>

        <Button
            android:id="@+id/btnPlayA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Play / Pause"
            android:layout_marginBottom="6dp"/>

        <Button
            android:id="@+id/btnCueA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CUE"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Velocidade / Pitch"
            android:textColor="#AAAAAA"
            android:textSize="11sp"/>

        <SeekBar
            android:id="@+id/seekBarPitchA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volume Deck A"
            android:textColor="#AAAAAA"
            android:textSize="11sp"/>

        <SeekBar
            android:id="@+id/seekBarVolumeA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100"/>

    </LinearLayout>

    <!-- ================= MIXER CENTRAL (Centro) ================= -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="8dp"
        app:layout_constraintWidth_percent="0.20"
        app:layout_constraintStart_toEndOf="@id/deckA_layout"
        app:layout_constraintEnd_toStartOf="@id/deckB_layout"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MIXER"
            android:textColor="#FF9800"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CROSSFADER"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:layout_marginBottom="8dp"/>

        <SeekBar
            android:id="@+id/seekBarCrossfader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="100"/>

    </LinearLayout>

    <!-- ================= DECK B (Direita) ================= -->
    <LinearLayout
        android:id="@+id/deckB_layout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="#1E1E1E"
        android:padding="12dp"
        app:layout_constraintWidth_percent="0.38"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DECK B"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvTrackB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nenhuma música carregada"
            android:textColor="#FF9800"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnLoadB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Carregar Música"
            android:layout_marginBottom="6dp"/>

        <Button
            android:id="@+id/btnPlayB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Play / Pause"
            android:layout_marginBottom="6dp"/>

        <Button
            android:id="@+id/btnCueB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CUE"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Velocidade / Pitch"
            android:textColor="#AAAAAA"
            android:textSize="11sp"/>

        <SeekBar
            android:id="@+id/seekBarPitchB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="50"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volume Deck B"
            android:textColor="#AAAAAA"
            android:textSize="11sp"/>

        <SeekBar
            android:id="@+id/seekBarVolumeB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
